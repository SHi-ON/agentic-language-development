# Rust build outputs: the default target/ plus the documented campaign cache
# (CONFIGURATION.md Toolchain; CARGO_TARGET_DIR=$PWD/env/cargo-target).
/target/
/env/

# Dyad evidence roots written by docs/reproduction.md (./evidence,
# ./evidence-2, ./evidence-dev, ...).
/evidence*/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Regenerable reports. NOTE: reports/research/statistical-validation.tsv is
# tracked (tested receipt); this rule does not untrack it.
/reports/

# Python sidecar (uv-managed) and local-only scratch.
.venv/
.env
.env.*
!.env.example
/plans/
**/tickets/
/artifacts/
.artifacts/
__pycache__/
