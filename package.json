{
  "name": "agentic-language-development",
  "version": "0.1.537",
  "private": true,
  "description": "Research infrastructure for grounded, auditable emergent agent communication",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:paper": "vitest run packages/learners/__tests__/recurrent-model.test.ts packages/learners/__tests__/recurrent-adapters.test.ts packages/learners/__tests__/ledger-value-prediction.test.ts packages/learners/__tests__/lv01-shared-draw.test.ts packages/analysis/__tests__/ledger-value.test.ts packages/orchestrator/__tests__/experiments/lv01-ordinary-loader.test.ts packages/orchestrator/__tests__/experiments/lv01-ordinary-wiring.test.ts packages/orchestrator/__tests__/experiments/lv01-schedule.test.ts packages/orchestrator/__tests__/experiments/lv01-action-draw.test.ts packages/orchestrator/__tests__/experiments/lv01-ledger-treatments.test.ts packages/orchestrator/__tests__/experiments/lv01-paired-predictions.test.ts packages/orchestrator/__tests__/experiments/lv01-paired-prediction-evidence.test.ts packages/orchestrator/__tests__/experiments/lv01-collector-live.test.ts packages/orchestrator/__tests__/experiments/lv01-auditor.test.ts packages/orchestrator/__tests__/experiments/lv01-stage-audit.test.ts packages/orchestrator/__tests__/experiments/lv01-batch-integrity.test.ts packages/hashing/__tests__/canonical.test.ts packages/checkpoint/__tests__/checkpoint-service.test.ts packages/orchestrator/__tests__/ala/ala-seeds.test.ts packages/orchestrator/__tests__/ala/ala-workload.test.ts packages/orchestrator/__tests__/ala/ala-manifest.test.ts packages/orchestrator/__tests__/ala/ala-runner-gates.test.ts packages/orchestrator/__tests__/ala/ala-mutation-matrix.test.ts",
    "test:integrity-auditor": "CARGO_TARGET_DIR=.artifacts/cargo-target cargo test --locked --manifest-path tools/integrity-auditor/Cargo.toml && CARGO_TARGET_DIR=.artifacts/cargo-target cargo clippy --locked --manifest-path tools/integrity-auditor/Cargo.toml -- -D warnings",
    "lint": "eslint packages",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:data-claims": "tsx scripts/build-data-claim-manifest.ts",
    "build:data-claim-manifest": "tsx scripts/build-data-claim-manifest.ts --write",
    "build:conformance-matrix": "node scripts/build-conformance-matrix.mjs",
    "lint:conformance-matrix": "node scripts/build-conformance-matrix.mjs --check",
    "check": "pnpm run lint && pnpm run scan:secrets && pnpm run audit:dependencies && pnpm run build && pnpm run test:paper",
    "paper:validate": "node scripts/paper.mjs validate",
    "paper:qualify": "node scripts/paper.mjs qualify",
    "paper:calibrate": "node scripts/paper.mjs calibrate",
    "paper:freeze": "node scripts/paper.mjs freeze",
    "paper:run": "node scripts/paper.mjs run",
    "paper:audit": "node scripts/paper.mjs audit",
    "paper:analyze": "node scripts/paper.mjs analyze",
    "paper:export": "node scripts/paper.mjs export",
    "paper:reproduce": "node scripts/paper.mjs reproduce",
    "check:ala-protocol": "node scripts/check-ala-protocol.mjs"
  },
  "devDependencies": {
    "@ald/analysis": "workspace:*",
    "@ald/anchor": "workspace:*",
    "@ald/gateway": "workspace:*",
    "@ald/hashing": "workspace:*",
    "@ald/learners": "workspace:*",
    "@ald/lifecycle": "workspace:*",
    "@ald/ops": "workspace:*",
    "@ald/orchestrator": "workspace:*",
    "@ald/scenario": "workspace:*",
    "@ald/types": "workspace:*",
    "@ald/verifier": "workspace:*",
    "@napi-rs/canvas": "1.0.10",
    "@types/node": "24.9.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "marked": "18.0.14",
    "pdfjs-dist": "6.4.299",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "12.3.4"
  },
  "dependencies": {}
}
