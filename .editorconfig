root = true

# Rust sources are formatted by rustfmt (4-space indent); rustfmt wins
# over the 2-space default below. Keep this section in sync with
# `cargo fmt` defaults (no rustfmt.toml in tree).
[*.rs]
indent_size = 4

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
