# Embedder contract for ald-config::load_runtime_environment
# (`ala run` validates the process environment against it at startup).
# Non-secret local defaults only; every key matches CONFIGURATION.md with the same default.
ALD_DTSF_PORT=4123
ALD_TWIN_PACKS_DIR=./twin-packs
ALD_DEPLOYMENT_MODE=prototype
ALD_EVIDENCE_DIR=./evidence
ALD_DATABASE_PATH=./evidence/evidence.sqlite
ALD_LOG_LEVEL=info
ALD_ANCHOR_CLASS=simulated
ALD_BASE_NETWORK=base-sepolia

# Secret values and secret file paths are injected only by `fort run` (with FORT_HOST set).
# They are intentionally absent from this file (load_runtime_environment rejects
# direct ALD_RUN_SIGNER_SEEDS_JSON / ALD_BASE_RPC_URL / ALD_ANCHOR_KEY values).
# ALD_SIGNER_SEEDS_FILE=
# ALD_BASE_RPC_URL_FILE=
# ALD_ANCHOR_KEY_FILE=
